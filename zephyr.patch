diff --git a/boards/native/common/natsim_config.cmake b/boards/native/common/natsim_config.cmake
index 766937fb8e3..1fa9f448233 100644
--- a/boards/native/common/natsim_config.cmake
+++ b/boards/native/common/natsim_config.cmake
@@ -4,7 +4,7 @@
 set(zephyr_build_path ${APPLICATION_BINARY_DIR}/zephyr)
 
 target_link_options(native_simulator INTERFACE
-  "-T ${ZEPHYR_BASE}/boards/native/common/natsim_linker_script.ld")
+  "-Wl,-T,${ZEPHYR_BASE}/boards/native/common/natsim_linker_script.ld")
 
 if(SYSROOT_DIR)
   message(NOTICE "Appending --sysroot=${SYSROOT_DIR} to native_simulator")
@@ -18,6 +18,12 @@ endif()
 
 list(JOIN CMAKE_C_COMPILER_LAUNCHER " " launcher)
 
+# The runner is built against the host C library. A toolchain may use another compiler driver
+# for that than for the embedded code (cosmocc: Cosmopolitan Libc's).
+if(NOT DEFINED NATIVE_RUNNER_C_COMPILER)
+  set(NATIVE_RUNNER_C_COMPILER ${CMAKE_C_COMPILER})
+endif()
+
 if("${LINKER}" STREQUAL "lld")
   target_link_options(native_simulator INTERFACE "-fuse-ld=lld")
 endif()
@@ -27,7 +33,7 @@ set(nsi_config_content
   "NSI_AR:=${CMAKE_AR}"
   "NSI_BUILD_OPTIONS:=$<JOIN:$<TARGET_PROPERTY:native_simulator,INTERFACE_COMPILE_OPTIONS>,\ >"
   "NSI_BUILD_PATH:=${zephyr_build_path}/NSI"
-  "NSI_CC:=$<$<BOOL:${launcher}>:${launcher} >${CMAKE_C_COMPILER}"
+  "NSI_CC:=$<$<BOOL:${launcher}>:${launcher} >${NATIVE_RUNNER_C_COMPILER}"
   "NSI_OBJCOPY:=${CMAKE_OBJCOPY}"
   "NSI_EMBEDDED_CPU_SW:=${zephyr_build_path}/${KERNEL_ELF_NAME} ${CONFIG_NATIVE_SIMULATOR_EXTRA_IMAGE_PATHS}"
   "NSI_EXE:=${zephyr_build_path}/${KERNEL_EXE_NAME}"
@@ -39,6 +45,11 @@ set(nsi_config_content
   "NSI_LOCALIZE_OPTIONS:=--localize-symbol=CONFIG_* $<JOIN:$<TARGET_PROPERTY:native_simulator,LOCALIZE_EXTRA_OPTIONS>,\ >"
 )
 
+# A toolchain may also link the executable with its own command.
+if(DEFINED NATIVE_RUNNER_LINKER)
+  list(APPEND nsi_config_content "NSI_LINKER:=${NATIVE_RUNNER_LINKER}")
+endif()
+
 string(REPLACE ";" "\n" nsi_config_content "${nsi_config_content}")
 
 file(GENERATE OUTPUT "${zephyr_build_path}/NSI/nsi_config"
diff --git a/boards/native/common/natsim_linker_script.ld b/boards/native/common/natsim_linker_script.ld
index add80b86c75..aa1ed975349 100644
--- a/boards/native/common/natsim_linker_script.ld
+++ b/boards/native/common/natsim_linker_script.ld
@@ -13,7 +13,10 @@ SECTIONS
  {
 	symbol_to_keep :
 	{
-		KEEP(*(symbol_to_keep*));
+		/* Only allocated input: an empty one is not (zephyr.elf is a partial link), and it
+		 * would place other empty, unallocated sections amid the program's memory.
+		 */
+		KEEP(INPUT_SECTION_FLAGS(SHF_ALLOC) *(symbol_to_keep*));
 	}
  } INSERT AFTER .data;
 
