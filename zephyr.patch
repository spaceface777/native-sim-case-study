diff --git a/Kconfig.zephyr b/Kconfig.zephyr
index 53de7adc8c5..322f6f5e9fa 100644
--- a/Kconfig.zephyr
+++ b/Kconfig.zephyr
@@ -503,11 +503,17 @@ endchoice
 config LTO
 	bool "Link Time Optimization"
 	depends on !(GEN_ISR_TABLES || GEN_IRQ_VECTOR_TABLE) || ISR_TABLES_LOCAL_DECLARATION
-	depends on !NATIVE_LIBRARY
+	depends on !NATIVE_LIBRARY || TOOLCHAIN_SUPPORTS_NATIVE_LIBRARY_LTO
