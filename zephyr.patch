 # SPDX-License-Identifier: Apache-2.0
 
-if(NOT CMAKE_HOST_UNIX OR CMAKE_HOST_APPLE)
+# Other hosts can build when cross-compiling for an explicit NATIVE_TARGET_HOST, e.g. with
+# cosmocc, whose executables also run on macOS and Windows.
+if((NOT CMAKE_HOST_UNIX OR CMAKE_HOST_APPLE) AND NOT DEFINED NATIVE_TARGET_HOST)
