+      - host
+      - llvm
+      - cosmocc
diff --git a/cmake/linker/ld/linker_flags.cmake b/cmake/linker/ld/linker_flags.cmake
index 537a00e8158..80c82a18970 100644
--- a/cmake/linker/ld/linker_flags.cmake
+++ b/cmake/linker/ld/linker_flags.cmake
@@ -44,6 +44,13 @@ else()
 endif()
 
 set_property(TARGET linker PROPERTY partial_linking "-r")
+if(CONFIG_LTO)
+  # Optimize while partially linking, into code: a native library is linked as such later.
+  # Only its interface (NATIVE_SIMULATOR_IF) is visible outside it: the rest is the whole
+  # program's own.
+  set_property(TARGET linker APPEND PROPERTY partial_linking
+               -flinker-output=nolto-rel -fwhole-program)
+endif()
 
 set_property(TARGET linker PROPERTY lto_arguments -flto=auto -fno-ipa-sra -ffunction-sections -fdata-sections)
 set_property(TARGET linker PROPERTY lto_arguments_st -flto=1 -fno-ipa-sra -ffunction-sections -fdata-sections)
diff --git a/cmake/modules/FindHostTools.cmake b/cmake/modules/FindHostTools.cmake
index 944ba887a4a..cc501356c67 100644
--- a/cmake/modules/FindHostTools.cmake
+++ b/cmake/modules/FindHostTools.cmake
@@ -63,11 +63,12 @@ if("${PTY_INTERFACE}" STREQUAL "PTY_INTERFACE-NOTFOUND")
 endif()
 
 # When targeting a host based target default to the host system's toolchain,
-# unless the user has selected to build with llvm (which is also valid for hosts builds)
-# or they are clearly trying to cross-compile a native simulator based target
+# unless the user has selected to build with llvm or cosmocc (which are also valid for host
+# builds) or they are clearly trying to cross-compile a native simulator based target
 if((${BOARD_DIR} MATCHES "boards\/native") OR ("${ARCH}" STREQUAL "posix")
    OR ("${BOARD}" STREQUAL "unit_testing"))
   if((NOT "${ZEPHYR_TOOLCHAIN_VARIANT}" STREQUAL "host/llvm") AND
+     (NOT "${ZEPHYR_TOOLCHAIN_VARIANT}" STREQUAL "cosmocc") AND
      (NOT ("${ZEPHYR_TOOLCHAIN_VARIANT}" STREQUAL "cross-compile" AND DEFINED NATIVE_TARGET_HOST)))
     set(ZEPHYR_TOOLCHAIN_VARIANT "host")
   endif()
diff --git a/cmake/toolchain/cosmocc/Kconfig.defconfig b/cmake/toolchain/cosmocc/Kconfig.defconfig
new file mode 100644
index 00000000000..bb1de7a35ce
--- /dev/null
+++ b/cmake/toolchain/cosmocc/Kconfig.defconfig
@@ -0,0 +1,18 @@
+# SPDX-License-Identifier: Apache-2.0
+
+# Zephyr's code is freestanding, and cosmocc provides only the few headers that Zephyr's
+# minimal C library needs: picolibc needs more. The native simulator runner uses
+# Cosmopolitan Libc.
+choice LIBC_IMPLEMENTATION
+	default MINIMAL_LIBC
+endchoice
+
+config PICOLIBC_SUPPORTED
+	default n
+
+# The heap native_sim has with its other C libraries.
+config COMMON_LIBC_MALLOC_ARENA_SIZE
+	default 16384
+
+config TOOLCHAIN_SUPPORTS_NATIVE_LIBRARY_LTO
+	default y
diff --git a/cmake/toolchain/cosmocc/generic.cmake b/cmake/toolchain/cosmocc/generic.cmake
new file mode 100644
index 00000000000..382d8dfddeb
--- /dev/null
+++ b/cmake/toolchain/cosmocc/generic.cmake
@@ -0,0 +1,171 @@
+# SPDX-License-Identifier: Apache-2.0
+
+# cosmocc: GCC and GNU binutils for Cosmopolitan Libc (https://github.com/jart/cosmopolitan).
+# Set COSMOCC_TOOLCHAIN_PATH to an extracted cosmocc release.
+#
+# By default, native_sim executables are for this host only: ELF built with cosmocc's
+# Linux-only libraries on Linux, PE on Windows. On macOS, for which cosmocc cannot make
+# native executables, zephyr.exe is a script that starts the ELF program, zephyr.exe.dbg,
+# through Cosmopolitan's loader.
+# With COSMOCC_PORTABLE, they are instead Actually Portable Executables: an x86-64 one runs
+# on Linux, macOS and Windows, an AArch64 one on Linux and macOS (on macOS through the loader).
+
+zephyr_get(COSMOCC_TOOLCHAIN_PATH)
+assert(COSMOCC_TOOLCHAIN_PATH "COSMOCC_TOOLCHAIN_PATH is not set")
+# cosmocc's driver scripts need / separators, also on Windows.
+file(TO_CMAKE_PATH "${COSMOCC_TOOLCHAIN_PATH}" COSMOCC_TOOLCHAIN_PATH)
+zephyr_get(COSMOCC_PORTABLE)
+
+# Build for the host CPU by default. Cosmopolitan supports Windows on x86-64 only.
+if(NOT DEFINED NATIVE_TARGET_HOST)
+  cmake_host_system_information(RESULT host_cpu QUERY OS_PLATFORM)
+  if(CMAKE_HOST_WIN32 OR host_cpu MATCHES "^(x86_64|AMD64|amd64)$")
+    set(NATIVE_TARGET_HOST x86_64)
+  else()
+    set(NATIVE_TARGET_HOST aarch64)
+  endif()
+endif()
+set(cosmocc_triple ${NATIVE_TARGET_HOST}-linux-cosmo)
+set(cosmocc_bin ${COSMOCC_TOOLCHAIN_PATH}/bin)
+if(CMAKE_HOST_UNIX AND NOT CMAKE_HOST_APPLE AND NOT COSMOCC_PORTABLE)
+  set(COSMOCC_LINUX_ONLY TRUE)
+endif()
+
+# Zephyr's files for this cosmocc are the same for all builds on this host: they are kept in
+# the user cache where possible. Write each one only if it differs, atomically, as parallel
+# builds may use them. In script mode (verify-toolchain), write none.
+string(MD5 cosmocc_hash "${COSMOCC_TOOLCHAIN_PATH}")
+set(cosmocc_dir ${USER_CACHE_DIR}/cosmocc/${cosmocc_hash})
+function(cosmocc_install path content)
+  if(CMAKE_SCRIPT_MODE_FILE)
+    return()
+  elseif(EXISTS ${path})
+    file(READ ${path} old)
+    if(old STREQUAL content)
+      return()
+    endif()
+  endif()
+  string(RANDOM LENGTH 8 suffix)
+  file(WRITE ${path}.${suffix} "${content}")
+  if(ARGN STREQUAL "EXECUTABLE")
+    file(CHMOD ${path}.${suffix} FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
+  endif()
+  file(RENAME ${path}.${suffix} ${path})
+endfunction()
+
+# cosmocc 4.0.2 lacks GCC's freestanding headers (its own include its C library's). GCC needs
+# an include directory of its own, and Zephyr's C library needs them: put them where GCC looks
+# for its own headers. Other cosmocc builds have them, and may then be read-only.
+file(GLOB cosmocc_gcc_versions ${COSMOCC_TOOLCHAIN_PATH}/libexec/gcc/${cosmocc_triple}/*)
+foreach(version_dir ${cosmocc_gcc_versions})
+  get_filename_component(version ${version_dir} NAME)
+  set(include ${COSMOCC_TOOLCHAIN_PATH}/lib/gcc/${cosmocc_triple}/${version}/include)
+  if(NOT EXISTS ${include}/stddef.h)
+    foreach(header stddef.h stdarg.h)
+      file(READ ${CMAKE_CURRENT_LIST_DIR}/include/${header} content)
+      cosmocc_install(${include}/${header} "${content}")
+    endforeach()
+  endif()
+endforeach()
+
+# Cosmopolitan programs are Windows executables, once named so. Elsewhere, CMake cannot
+# start them without an APE loader registered with the kernel, but any shell can.
+set(cosmocc_tools gcc g++ ar nm objcopy objdump readelf strip ranlib ld.bfd)
+if(CMAKE_HOST_WIN32)
+  # Next to the originals: GCC finds its programs relative to its own.
+  set(CROSS_COMPILE ${cosmocc_bin}/${cosmocc_triple}-)
+  foreach(tool ${cosmocc_tools})
+    if(NOT CMAKE_SCRIPT_MODE_FILE)
+      configure_file(${CROSS_COMPILE}${tool} ${CROSS_COMPILE}${tool}.exe COPYONLY)
+    endif()
+  endforeach()
+else()
+  set(CROSS_COMPILE ${cosmocc_dir}/${cosmocc_triple}-)
+  foreach(tool ${cosmocc_tools})
+    cosmocc_install(${CROSS_COMPILE}${tool}
+      "#!/bin/sh\nexec '${cosmocc_bin}/${cosmocc_triple}-${tool}' \"$@\"\n" EXECUTABLE)
+  endforeach()
+endif()
+
+# Zephyr's code is freestanding. The native simulator runner uses Cosmopolitan Libc, through
+# cosmocc's own compiler driver, which also links the executable. It is started by a script:
+# cosmocc's driver finds itself through its path, which make on Windows gives it with \.
+set(cosmocc_driver ${cosmocc_bin}/${NATIVE_TARGET_HOST}-unknown-cosmo-cc)
+if(COSMOCC_LINUX_ONLY)
+  set(cosmocc_driver_flags -moptlinux)
+  set(cosmocc_kind linux)
+else()
+  # Unlike -moptlinux, which needs no such flags, the driver otherwise prepares functions for
+  # Cosmopolitan's function call tracer (--ftrace), at some cost in speed. Undo that.
+  set(cosmocc_driver_flags "-fpatchable-function-entry=0 -finline-functions-called-once")
+  if(COSMOCC_PORTABLE)
+    set(cosmocc_kind portable)
+  else()
+    set(cosmocc_kind host)
+  endif()
+endif()
+# Its scripts differ between kinds of executables, which builds that share cosmocc may mix.
+set(cosmocc_scripts ${cosmocc_dir}/${NATIVE_TARGET_HOST}-${cosmocc_kind})
+set(NATIVE_RUNNER_C_COMPILER ${cosmocc_scripts}-cc)
+cosmocc_install(${NATIVE_RUNNER_C_COMPILER}
+  "#!/bin/sh\nexec '${cosmocc_driver}' ${cosmocc_driver_flags} \"$@\"\n" EXECUTABLE)
+set(NATIVE_RUNNER_LINKER ${NATIVE_RUNNER_C_COMPILER})
+
+# On Linux, the driver's Linux-only executables are ELF. Elsewhere, finish its executables:
+if(CMAKE_HOST_APPLE AND NOT COSMOCC_PORTABLE)
+  # cosmocc cannot make Mach-O executables that macOS accepts. The executable is a script
+  # that starts the ELF program (its .dbg file) through Cosmopolitan's loader.
+  if(NATIVE_TARGET_HOST STREQUAL "aarch64")
+    set(ape_source ${cosmocc_bin}/ape-m1.c)
+  else()
+    set(ape_source ${cosmocc_bin}/ape-x86_64.macho)
+  endif()
+  file(MD5 ${ape_source} ape_hash)
+  set(ape ${cosmocc_dir}/ape-${ape_hash})
+  if(NOT EXISTS ${ape} AND NOT CMAKE_SCRIPT_MODE_FILE)
+    string(RANDOM LENGTH 8 suffix)
+    file(MAKE_DIRECTORY ${cosmocc_dir})
+    if(NATIVE_TARGET_HOST STREQUAL "aarch64")
+      execute_process(COMMAND cc -O2 -o ${ape}.${suffix} ${ape_source} COMMAND_ERROR_IS_FATAL ANY)
+    else()
+      configure_file(${ape_source} ${ape}.${suffix} COPYONLY
+                     FILE_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
+    endif()
+    file(RENAME ${ape}.${suffix} ${ape})
+  endif()
+  string(CONCAT finish
+    "printf '#!/bin/sh\\nexec \"%s\" \"$0.dbg\" \"$@\"\\n' '${ape}' >\"$out\"\n"
+    "chmod +x \"$out\"\n")
+elseif(NATIVE_TARGET_HOST STREQUAL "x86_64" AND NOT COSMOCC_LINUX_ONLY)
+  # The driver's x86-64 portable executables are also PE files. Their PE header extends the
+  # data section up to .bss, but the file ends with the data's last section: other sections
+  # than .data, like Zephyr's, leave it short, and Windows refuses it. Pad it, then append
+  # the zip archive again, as the driver does.
+  string(CONCAT finish
+    "x='${cosmocc_bin}/x86_64-linux-cosmo-'\n"
+    "sym() { \"$x\"nm \"$out.dbg\" | awk -v s=\"$1\" '$3 == s {print $1}'; }\n"
+    "size=$((0x$(sym ape_ram_paddr) + 0x$(sym ape_ram_filesz) - 0x$(sym ape_cod_paddr)))\n"
+    "\"$x\"objcopy -S -O binary \"$out.dbg\" \"$out\" || exit\n"
+    "have=$(($(wc -c <\"$out\")))\n"
+    "[ $have -ge $size ] || head -c $((size - have)) /dev/zero >>\"$out\"\n"
+    "exec '${cosmocc_bin}/zipcopy' \"$out.dbg\" \"$out\"\n")
+endif()
+if(DEFINED finish)
+  set(NATIVE_RUNNER_LINKER ${cosmocc_scripts}-link)
+  string(CONCAT script "#!/bin/sh\n"
+    "'${cosmocc_driver}' ${cosmocc_driver_flags} \"$@\" || exit\n"
+    "while [ $# -gt 1 ]; do [ \"$1\" != -o ] || out=$2; shift; done\n"
+    "case $out in *.exe | *.com) ;; *) exit 0 ;; esac\n"
+    "${finish}")
+  cosmocc_install(${NATIVE_RUNNER_LINKER} "${script}" EXECUTABLE)
+endif()
+
+set(SYSROOT_DIR ${COSMOCC_TOOLCHAIN_PATH}/${cosmocc_triple})
+# cosmocc's driver writes the executable's symbols to an ELF file with this suffix.
+set(NATIVE_EXE_SYMBOLS_SUFFIX .dbg)
+
+set(COMPILER gcc)
+set(LINKER ld)
+set(BINTOOLS gnu)
+
+message(STATUS "Found toolchain: cosmocc (${COSMOCC_TOOLCHAIN_PATH})")
diff --git a/cmake/toolchain/cosmocc/include/stdarg.h b/cmake/toolchain/cosmocc/include/stdarg.h
new file mode 100644
index 00000000000..e96234b84da
--- /dev/null
+++ b/cmake/toolchain/cosmocc/include/stdarg.h
