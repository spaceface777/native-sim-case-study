@@ -0,0 +1,34 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Freestanding <stddef.h> for cosmocc, which has no compiler-provided one.
+ */
+#ifndef ZEPHYR_COSMOCC_STDDEF_H_
+#define ZEPHYR_COSMOCC_STDDEF_H_
+
+typedef __SIZE_TYPE__ size_t;
+typedef __PTRDIFF_TYPE__ ptrdiff_t;
+#ifndef __cplusplus
+typedef __WCHAR_TYPE__ wchar_t;
+#endif
+typedef struct {
+	long long max_align_ll __attribute__((__aligned__(__alignof__(long long))));
+	long double max_align_ld __attribute__((__aligned__(__alignof__(long double))));
+} max_align_t;
+
+#undef NULL
+#ifdef __cplusplus
+#define NULL __null
+#else
+#define NULL ((void *)0)
+#endif
+#define offsetof(type, member) __builtin_offsetof(type, member)
+
+#endif /* ZEPHYR_COSMOCC_STDDEF_H_ */
+
+/* As GCC's: C libraries may ask for wint_t, defined only on request. */
+#if defined(__need_wint_t) && !defined(ZEPHYR_COSMOCC_WINT_T_)
+#define ZEPHYR_COSMOCC_WINT_T_
+typedef __WINT_TYPE__ wint_t;
+#endif
+#undef __need_wint_t
diff --git a/cmake/toolchain/cosmocc/target.cmake b/cmake/toolchain/cosmocc/target.cmake
new file mode 100644
index 00000000000..4f476d8e86f
--- /dev/null
+++ b/cmake/toolchain/cosmocc/target.cmake
@@ -0,0 +1,19 @@
+# SPDX-License-Identifier: Apache-2.0
+
+# Cosmopolitan's ABI, as cosmocc applies it to all code. The link needs it too: link time
+# optimization generates code then, and does not keep options such as -ffixed-x28.
+if(NATIVE_TARGET_HOST STREQUAL "x86_64")
+  if(NOT COSMOCC_LINUX_ONLY)
+    # No red zone: Windows writes below the stack pointer. TLS the runtime can relocate.
+    set(cosmocc_abi_flags -mno-red-zone -mno-tls-direct-seg-refs)
+  endif()
+else()
+  # x18 is reserved by macOS, and x28 holds Cosmopolitan's TLS pointer.
+  set(cosmocc_abi_flags -ffixed-x18 -ffixed-x28 -fsigned-char)
+endif()
+list(APPEND TOOLCHAIN_C_FLAGS ${cosmocc_abi_flags})
+list(APPEND TOOLCHAIN_LD_FLAGS ${cosmocc_abi_flags})
+
+if(NOT CONFIG_64BIT)
+  message(FATAL_ERROR "cosmocc builds 64-bit programs only: use native_sim/native/64")
+endif()
