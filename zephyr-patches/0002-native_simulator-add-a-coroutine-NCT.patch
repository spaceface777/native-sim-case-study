index a154376d292..82d0517251a 100644
--- a/boards/native/common/natsim_config.cmake
+++ b/boards/native/common/natsim_config.cmake
@@ -25,6 +25,8 @@ endif()
 foreach(component NCE NCT)
   if(CONFIG_NATIVE_SIMULATOR_${component}_CUSTOM)
     set(nsi_${component} custom)
+  elseif(CONFIG_NATIVE_SIMULATOR_${component}_COROUTINES)
