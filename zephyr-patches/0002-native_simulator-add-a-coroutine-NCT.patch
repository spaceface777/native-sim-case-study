 scripts/native_simulator/Makefile             |   7 +
 .../native_simulator/common/coro/nct_coro.c   | 175 ++++++++++++++++++
 .../native_simulator/common/coro/nsi_coro.c   |  87 +++++++++
 .../native_simulator/common/coro/nsi_coro.h   |  38 ++++
 soc/native/inf_clock/Kconfig                  |  19 ++
 6 files changed, 328 insertions(+)
 create mode 100644 scripts/native_simulator/common/coro/nct_coro.c
 create mode 100644 scripts/native_simulator/common/coro/nsi_coro.c
 create mode 100644 scripts/native_simulator/common/coro/nsi_coro.h

